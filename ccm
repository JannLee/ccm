def cmd_statusline(args):
    raw = b"" if sys.stdin.isatty() else sys.stdin.buffer.read()
    try:
        payload = json.loads(raw.decode("utf-8") or "{}")
    except ValueError:
        payload = {}
    try:
        cfg = load_config()
    except CcmError:
        # 설정 파일이 깨져도 상태줄은 비우지 않는다. 추가한 계정은 알아볼 수 없어 기록하지 않는다
        cfg = {"profiles": {DEFAULT: {}}, "current": DEFAULT}
    name = detect_profile(cfg)
    now = time.time()
    # 같은 계정의 다른 세션이 더 최근 값을 기록했을 수 있으므로 합친 기록을 보여 준다
    rec = {"windows": extract_windows(payload)}
    if name:
        try:
            rec = record_usage(name, payload, now)
        except OSError:
            pass
    label = name or Path(os.environ.get("CLAUDE_CONFIG_DIR", "?")).name
    seg = status_segment(label, rec, Paint(not os.environ.get("NO_COLOR")), now)
    base = run_wrapped(args.wrap, raw)
    lines = base.split("\n") if base else []
    if lines:
        lines[-1] = f"{lines[-1]}  {seg}"
    else:
        lines = [seg]
    sys.stdout.write("\n".join(lines))
    return 0


def install_statusline():
    path = settings_path()
    settings = read_json(path, None)
    if settings is None:
        if path.exists():
            raise CcmError(f"{path}를 JSON으로 읽지 못했습니다.")
        settings = {}
    current = settings.get("statusLine")
    if is_ccm_statusline(current):
        if current.get("command") == statusline_command():
            return "이미 연결되어 있습니다"
        current["command"] = statusline_command()
        write_json(path, settings, 0o644)
        return "명령 경로를 갱신했습니다"
    write_json(ccm_home() / "statusline-prev.json", {"statusLine": current})
    if path.exists():
        backup = path.with_name(f"settings.json.ccm-backup-{time.strftime('%Y%m%d-%H%M%S')}")
        shutil.copy2(path.resolve(), backup)
    new = {k: v for k, v in (current or {}).items() if k != "command"}
    new.update(type="command", command=statusline_command())
    settings["statusLine"] = new
    write_json(path, settings, 0o644)
    kept = " (기존 상태줄 출력 뒤에 붙습니다)" if (current or {}).get("command") else ""
    return f"연결했습니다{kept}"


def uninstall_statusline():
    path = settings_path()
    settings = read_json(path, None)
    if not settings or not is_ccm_statusline(settings.get("statusLine")):
        return "연결되어 있지 않습니다"
    prev_path = ccm_home() / "statusline-prev.json"
    old = (read_json(prev_path, {}) or {}).get("statusLine")
    if old:
        settings["statusLine"] = old
    else:
        settings.pop("statusLine", None)
    write_json(path, settings, 0o644)
    prev_path.unlink(missing_ok=True)
    return "이전 설정으로 되돌렸습니다"


def install_shell_hook():
    rc = rc_file()
    text = rc.read_text(encoding="utf-8") if rc.exists() else ""
    if RC_BEGIN in text:
        new = strip_rc_block(text)
        new = new + ("" if not new or new.endswith("\n") else "\n") + "\n" + shell_function()
        status = "갱신했습니다"
    else:
        new = text + ("" if not text or text.endswith("\n") else "\n") + "\n" + shell_function()
        status = "추가했습니다"
    if new == text:
        return "이미 설치되어 있습니다"
    write_text(rc, new, 0o644)
    return status


def uninstall_shell_hook():
    rc = rc_file()
    if not rc.exists():
        return "설치되어 있지 않습니다"
    text = rc.read_text(encoding="utf-8")
    if RC_BEGIN not in text:
        return "설치되어 있지 않습니다"
    write_text(rc, strip_rc_block(text), 0o644)
    return "지웠습니다"


