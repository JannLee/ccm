def build_parser():
    ap = argparse.ArgumentParser(
        prog="ccm",
        description=tr("Claude Code 계정 프로필 관리: 계정별 사용량을 보고 바로 전환합니다. "
                       "인자 없이 실행하면 사용량 표에서 방향키로 계정을 골라 claude를 실행합니다.",
                       "Manage Claude Code account profiles: see usage per account and switch right away. "
                       "Run without arguments to pick an account from the usage table with the arrow keys and start claude."))
    ap.add_argument("--version", action="version", version=f"ccm {VERSION}")
    sub = ap.add_subparsers(dest="cmd", metavar=tr("명령", "command"))
    if WINDOWS:
        p = sub.add_parser("install", help=tr("Windows 명령 실행 파일 설치·갱신", "install or update Windows launchers"))
        p.set_defaults(func=cmd_install)
    no_launch = tr("계정만 바꾸고 claude는 실행하지 않음", "switch only; don't start claude")
    name_help = tr("이름, 번호, 이메일 일부", "name, number, or part of the email")

    p = sub.add_parser("pick", help=tr("사용량 표를 보고 계정을 골라 claude 실행 (기본 명령)",
                                       "pick an account from the usage table and start claude (default)"))
