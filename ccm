def cmd_doctor(args):
    cfg = load_config()
    refresh_info(cfg)
    save_config(cfg)
    warn = 0

    def report(ok, text):
        nonlocal warn
        warn += 0 if ok else 1
        print(f"{'✓' if ok else '!'} {text}")

    exe = claude_bin()
    report(bool(shutil.which(exe)), f"claude 실행 파일: {shutil.which(exe) or '찾지 못함'}")
    notice = override_notice()
    if notice:
        report(False, notice)
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        report(False, "현재 셸에 CLAUDE_CONFIG_DIR이 설정되어 있어 셸 함수가 계정을 바꾸지 않습니다")
    link = install_link_problem()
    if link and link[1] and args.fix:
        relink_install()
        print(f"  · ccm 링크를 다시 만들었습니다: {bin_dir() / 'ccm'} -> {Path(__file__).resolve()}")
        link = install_link_problem()
    if link:
        report(False, f"ccm 명령: {link[0]}" + (" (`./ccm doctor --fix`)" if link[1] else ""))
    else:
        report(True, f"ccm 명령: {shutil.which('ccm')}")
    sl = statusline_problem()
    if sl and sl[1] and args.fix:
        print(f"  · 상태줄 명령: {install_statusline()}")
        sl = statusline_problem()
    report(sl is None, "상태줄 연결" if sl is None else sl[0])
    rc = rc_file()
    hooked = rc.exists() and RC_BEGIN in rc.read_text(encoding="utf-8")
    report(hooked, f"셸 함수 {rc}" + ("" if hooked else " 에 없음 (`ccm setup`)"))
    seen = {}
    for name, p in cfg["profiles"].items():
        label = account_label(cfg, name)
        info = p.get("info") or {}
        report(bool(info.get("loggedIn")) and not info.get("error"), f"[{name}] {label}")
        key = (info.get("email"), info.get("orgName"))
        if info.get("email"):
            if key in seen:
                report(False, f"[{name}] {seen[key]} 프로필과 같은 계정입니다")
            seen.setdefault(key, name)
        if name == DEFAULT or not profile_dir(name).is_dir():
            continue
        if args.fix:
            done = repair_links(profile_dir(name), p.get("share_history", True), name)
            if done:
                print(f"  · 다시 연결했습니다: {describe_repairs(done)}")
        for item, problem, fixable in link_problems(cfg, name):
            hint = " (`ccm doctor --fix`)" if fixable else ""
            report(False, f"[{name}] {item}: {problem}{hint}")
    print("문제 없음" if warn == 0 else f"확인할 항목 {warn}개")
    return 0 if warn == 0 else 1


def build_parser():
    ap = argparse.ArgumentParser(
        prog="ccm",
        description="Claude Code 계정 프로필 관리: 계정별 사용량을 보고 바로 전환합니다. "
                    "인자 없이 실행하면 사용량 표에서 방향키로 계정을 골라 claude를 실행합니다.")
    ap.add_argument("--version", action="version", version=f"ccm {VERSION}")
    sub = ap.add_subparsers(dest="cmd", metavar="명령")

    p = sub.add_parser("pick", help="사용량 표를 보고 계정을 골라 claude 실행 (기본 명령)")
    p.add_argument("-n", "--no-launch", action="store_true", help="계정만 바꾸고 claude는 실행하지 않음")
    p.set_defaults(func=cmd_pick)

    p = sub.add_parser("ls", help="계정별 로그인 상태와 사용량 표시")
    p.add_argument("--json", action="store_true", help="JSON으로 출력")
    p.set_defaults(func=cmd_ls)

    p = sub.add_parser("use", help="현재 계정 바꾸기 (셸 함수가 있으면 claude에 바로 적용)")
    p.add_argument("name", help="이름, 번호, 이메일 일부")
    p.set_defaults(func=cmd_use)

    p = sub.add_parser("run", help="지정한 계정으로 claude 한 번 실행 (현재 계정은 그대로)")
    p.add_argument("name")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("next", help="여유가 가장 많은 다른 계정으로 바꾸고 claude 실행 (예: ccm next -c)")
    p.add_argument("-n", "--no-launch", action="store_true", help="계정만 바꾸고 claude는 실행하지 않음")
    p.set_defaults(func=cmd_next)

    p = sub.add_parser("add", help="새 계정 프로필을 만들고 로그인")
    p.add_argument("name", help="프로필 이름 (예: work)")
    p.add_argument("--email", help="로그인 화면에 미리 넣을 이메일")
    p.add_argument("--sso", action="store_true", help="SSO 로그인 사용")
    p.add_argument("--no-share-history", action="store_true",
                   help="세션 기록을 공유하지 않음 (계정 전환 후 claude -c로 이어서 하기 불가)")
    p.add_argument("--no-sync", action="store_true",
                   help="default 계정의 MCP 서버와 폴더 신뢰 설정을 가져오지 않음")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("sync", help="한 계정의 MCP 서버와 폴더 신뢰 설정을 다른 계정에 복사")
    p.add_argument("names", nargs="*", metavar="이름", help="받을 계정 (생략하면 가져올 계정을 뺀 전부)")
    p.add_argument("--from", dest="source", default=DEFAULT, metavar="이름", help="가져올 계정 (기본 default)")
    p.add_argument("--replace", action="store_true", help="이름이 같고 설정이 다른 MCP 서버를 덮어씀")
    p.add_argument("--dry-run", action="store_true", help="바꿀 내용만 보여 주고 파일은 바꾸지 않음")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("login", help="기존 프로필에 다시 로그인")
    p.add_argument("name")
    p.add_argument("--email")
    p.add_argument("--sso", action="store_true")
    p.set_defaults(func=cmd_login)

    p = sub.add_parser("rm", help="프로필 삭제 (로그아웃 후 폴더 삭제)")
    p.add_argument("name")
    p.add_argument("-y", "--yes", action="store_true", help="확인 없이 삭제")
    p.set_defaults(func=cmd_rm)

    p = sub.add_parser("setup", help="상태줄 연결과 셸 함수 설치 (--undo로 되돌리기)")
    p.add_argument("--undo", action="store_true")
    p.add_argument("--no-shell", action="store_true", help="셸 함수는 설치하지 않음")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("doctor", help="설정 점검")
    p.add_argument("--fix", action="store_true", help="빠진 공유 링크, ccm 링크, 상태줄 명령 경로를 다시 연결")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("statusline", help="Claude Code 상태줄 명령 (setup이 등록)")
    p.add_argument("--wrap", help="함께 실행할 기존 상태줄 명령")
    p.set_defaults(func=cmd_statusline)

    p = sub.add_parser("shell-init", help="셸 함수 출력")
    p.set_defaults(func=cmd_shell_init)
    return ap


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-n", "--no-launch", "--"):
        argv = ["pick"] + argv
    # pick, run, next 뒤의 인자는 claude에 그대로 넘긴다 (예: ccm -- -c, ccm run work -c, ccm next -c)
    claude_args = []
    if argv[0] in ("pick", "run", "next") and "--" in argv:
        i = argv.index("--")
        argv, claude_args = argv[:i], argv[i + 1:]
    if argv[0] == "run" and len(argv) > 2:
        argv, claude_args = argv[:2], argv[2:] + claude_args
    if argv[0] == "next":
        own = [a for a in argv[1:] if a in ("-n", "--no-launch", "-h", "--help")]
        argv, claude_args = ["next"] + own, [a for a in argv[1:] if a not in own] + claude_args
    args = build_parser().parse_args(argv)
    args.claude_args = claude_args
    try:
        return args.func(args)
    except CcmError as e:
        print(f"ccm: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print(file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
