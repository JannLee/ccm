def shell_function():
    f = shlex.quote(str(ccm_home() / "current-dir"))
    return (
        f"{RC_BEGIN}\n"
        "# `ccm use <계정>`으로 고른 계정으로 claude를 실행한다. 지우려면 `ccm setup --undo`\n"
        "export CCM_SHELL_HOOK=1\n"
        "claude() {\n"
        f"  if [ -z \"${{CLAUDE_CONFIG_DIR:-}}\" ] && [ -s {f} ]; then\n"
        f"    CLAUDE_CONFIG_DIR=\"$(command cat {f})\" command claude \"$@\"\n"
        "  else\n"
        "    command claude \"$@\"\n"
        "  fi\n"
        "}\n"
        f"{RC_END}\n"
    )


def strip_rc_block(text):
    start = text.find(RC_BEGIN)
    end = text.find(RC_END, start)
    if start < 0 or end < 0:
        return text
    end += len(RC_END)
    if text[end:end + 1] == "\n":
        end += 1
    # 설치할 때 블록 앞에 넣은 빈 줄도 함께 지운다
    if text[max(0, start - 2):start] == "\n\n":
        start -= 1
    return text[:start] + text[end:]


