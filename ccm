def is_ccm_statusline(sl):
    cmd = ((sl or {}).get("command") or "").rstrip()
    return bool(encoded_statusline_paths(cmd)) or cmd.endswith(" statusline") and "ccm" in cmd


def encoded_statusline_paths(cmd):
    match = re.search(r"-EncodedCommand\s+([A-Za-z0-9+/=]+)$", cmd, re.IGNORECASE)
    if not match:
        return None
    try:
        script = base64.b64decode(match[1], validate=True).decode("utf-16-le")
        header = script.splitlines()[0]
        if not header.startswith("# ccm-statusline "):
            return None
        paths = json.loads(header[len("# ccm-statusline "):])
        if isinstance(paths, list) and len(paths) == 2 and all(isinstance(p, str) for p in paths):
            return paths
    except (ValueError, UnicodeError, IndexError):
        pass
    return None


def statusline_command():
    if WINDOWS:
        paths = [Path(sys.executable).as_posix(), script_path().as_posix()]
        script = ("# ccm-statusline " + json.dumps(paths, ensure_ascii=True) + "\n"
                  + f"& {ps_quote(paths[0])} -X utf8 {ps_quote(paths[1])} statusline\nexit $LASTEXITCODE")
        encoded = base64.b64encode(script.encode("utf-16-le")).decode("ascii")
        return f"powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand {encoded}"
    return f"{shlex.quote(sys.executable)} {shlex.quote(str(script_path()))} statusline"


def statusline_problem():
    """상태줄 설정을 점검한다. 문제가 없으면 None, 있으면 (안내문, `doctor --fix`로 고칠 수 있는지)를 돌려준다.

    명령에 적힌 Python이나 ccm 파일이 없으면 Claude Code는 오류를 보여 주지 않고 상태줄을 비워 둔다.
    그래서 ccm 폴더를 옮기면 사용량 기록이 소리 없이 멈추므로 파일이 실제로 있는지까지 확인한다.
    """
    sl = (read_json(settings_path(), {}) or {}).get("statusLine")
    if not is_ccm_statusline(sl):
        return tr("상태줄이 연결되어 있지 않아 사용량이 기록되지 않습니다. `ccm setup`을 실행하세요.",
                  "The status line isn't connected, so usage isn't recorded. Run `ccm setup`."), False
    try:
        paths = encoded_statusline_paths(sl["command"])
        words = [*paths, "statusline"] if paths else shlex.split(sl["command"])
    except ValueError:
        return None
    if len(words) >= 3 and not shutil.which(words[-3]):
        return tr(f"상태줄 명령에 적힌 Python({words[-3]})이 없어 사용량이 기록되지 않습니다. `ccm doctor --fix`로 고치세요.",
                  f"The Python in the status line command ({words[-3]}) is missing, so usage isn't recorded. "
                  "Fix it with `ccm doctor --fix`."), True
    script = words[-2] if len(words) >= 2 else ""
    if "/" in script and not Path(script).expanduser().exists() or "/" not in script and not shutil.which(script):
        return tr(f"상태줄 명령에 적힌 {script} 파일이 없어 사용량이 기록되지 않습니다. "
                  "ccm 폴더를 옮겼다면 새 위치에서 `./ccm doctor --fix`를 실행하세요.",
                  f"The file in the status line command ({script}) is missing, so usage isn't recorded. "
                  "If you moved the ccm folder, run `./ccm doctor --fix` in the new location."), True
    return None


def install_link_problem():
    """PATH의 ccm 명령을 점검한다. 문제가 없으면 None, 있으면 (안내문, `doctor --fix`로 고칠 수 있는지)를 돌려준다."""
    link, here = bin_dir() / "ccm", Path(__file__).resolve()
    if WINDOWS:
        expected = windows_launchers()
        stale = [name for name, content in expected.items()
                 if read_launcher(bin_dir() / name) != content]
        if stale:
            return tr(f"Windows 실행 파일 설치 또는 갱신 필요: {', '.join(stale)} (`.\\install.ps1`)",
                      f"Windows launchers need installing or updating: {', '.join(stale)} (`.\\install.ps1`)"), True
        found = shutil.which("ccm")
        if not found:
            return tr(f"PATH에 {bin_dir()} 폴더가 없습니다 (`.\\install.ps1`)",
                      f"{bin_dir()} isn't on PATH (`.\\install.ps1`)"), False
        if Path(found).parent.resolve() != bin_dir().resolve():
            return tr(f"PATH의 ccm이 다른 폴더에 있습니다: {found}", f"ccm on PATH is in another folder: {found}"), False
        return None
    if link.is_symlink() and not link.exists():
        return tr(f"{link} 링크가 가리키는 {os.readlink(link)} 파일이 없습니다",
                  f"{link} points to {os.readlink(link)}, which doesn't exist"), True
    found = shutil.which("ccm")
    if not found:
        return tr("PATH에서 ccm 명령을 찾지 못했습니다 (`./install.sh`)", "ccm isn't on your PATH (`./install.sh`)"), False
    if Path(found).resolve() != here:
        return tr(f"PATH의 ccm({found})이 지금 실행한 {here}와 다른 파일입니다",
                  f"ccm on your PATH ({found}) is a different file from the one you ran ({here})"), False
    return None


def relink_install():
    """install.sh처럼 ccm 링크가 이 파일을 가리키게 다시 만든다."""
    if WINDOWS:
        for name, content in windows_launchers().items():
            write_text(bin_dir() / name, ("\ufeff" if name.endswith(".ps1") else "") + content)
        return
    link = bin_dir() / "ccm"
