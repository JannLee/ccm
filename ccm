def update_locked_json(path, update, dry_run=False):
    """Claude Code와 같은 잠금(파일 이름 뒤에 .lock을 붙인 폴더)을 잡고 path의 JSON을 update(data)로 고친다.

    Claude Code도 이 잠금을 잡은 채로 파일을 다시 읽고 고쳐 저장하므로, 그 계정으로 실행 중인 세션이 있어도
    서로의 변경을 덮어쓰지 않는다. update의 반환값을 그대로 돌려준다.
    """
    lock = path.with_name(path.name + ".lock")
    deadline = time.time() + 2 * LOCK_STALE
    while True:
        try:
            lock.mkdir()
            break
        except FileExistsError:
            pass
        try:
            if time.time() - lock.stat().st_mtime > LOCK_STALE:
                lock.rmdir()  # 잠근 프로그램이 끝나면서 남긴 잠금
                continue
        except OSError:
            pass
        if time.time() > deadline:
            raise CcmError(f"{lock} 잠금이 풀리지 않습니다. 잠시 뒤 다시 실행하세요.")
        time.sleep(0.1)
    try:
        data = read_json(path)
        if not isinstance(data, dict):
            raise CcmError(f"{path}를 JSON으로 읽지 못했습니다.")
        before = json.dumps(data, sort_keys=True)
        result = update(data)
        if not dry_run and json.dumps(data, sort_keys=True) != before:
            write_json(path, data)
        return result
    finally:
        lock.rmdir()


def merge_servers(dst, src, replace):
    """MCP 서버 목록 src를 dst에 합친다. (추가한 이름, 덮어쓴 이름, 설정이 달라 그대로 둔 이름)을 돌려준다."""
    added, replaced, kept = [], [], []
    for key, conf in src.items():
        if key not in dst:
            dst[key] = conf
            added.append(key)
        elif dst[key] != conf:
            if replace:
                dst[key] = conf
                replaced.append(key)
            else:
                kept.append(key)
    return added, replaced, kept


def sync_config(src, dst, replace):
    """.claude.json 내용 src의 사용자 범위 MCP 서버, 폴더 신뢰 여부, 프로젝트별(로컬 범위) MCP 서버를 dst에 합친다."""
    report = {"servers": ([], [], []), "trusted": 0, "local": 0}
    servers = src.get("mcpServers")
    if isinstance(servers, dict) and servers:
        report["servers"] = merge_servers(dst.setdefault("mcpServers", {}), servers, replace)
    for path, p in (src.get("projects") or {}).items():
        if not isinstance(p, dict):
            continue
        trust = p.get("hasTrustDialogAccepted") is True
        local = p.get("mcpServers") if isinstance(p.get("mcpServers"), dict) else {}
        if not trust and not local:
            continue
        entry = dst.setdefault("projects", {}).setdefault(path, copy.deepcopy(DEFAULT_PROJECT))
        if not isinstance(entry, dict):
            continue
        if trust and entry.get("hasTrustDialogAccepted") is not True:
            entry["hasTrustDialogAccepted"] = True
            report["trusted"] += 1
        if local:
            added, replaced, _ = merge_servers(entry.setdefault("mcpServers", {}), local, replace)
            report["local"] += len(added) + len(replaced)
    return report


def describe_sync(report):
    added, replaced, kept = report["servers"]
    parts = []
    if added:
        parts.append(f"MCP 서버 {len(added)}개 추가({', '.join(added)})")
    if replaced:
        parts.append(f"MCP 서버 {len(replaced)}개 덮어씀({', '.join(replaced)})")
    if report["trusted"]:
        parts.append(f"신뢰한 폴더 {report['trusted']}개")
    if report["local"]:
        parts.append(f"프로젝트별 MCP 서버 {report['local']}개")
    text = " · ".join(parts) or "바꿀 것 없음"
    if kept:
        text += f" (설정이 달라 그대로 둔 MCP 서버: {', '.join(kept)}. 덮어쓰려면 `--replace`)"
    return text


def sync_profiles(source, targets, replace=False, dry_run=False):
    """source 계정의 .claude.json에서 MCP 서버와 폴더 신뢰 설정을 targets 계정에 복사한다. (계정, 결과) 목록을 돌려준다."""
    src_path = claude_json(source)
    if not src_path.exists():
        raise CcmError(f"{source} 계정의 {src_path}가 없습니다. 그 계정으로 Claude Code를 한 번 실행한 뒤 다시 하세요.")
    src = update_locked_json(src_path, lambda data: data, dry_run=True)
    results = []
    for name in targets:
        path = claude_json(name)
        if name == source:
            continue
        if not path.exists():
            results.append((name, "아직 Claude Code를 실행하지 않아 건너뜀"))
            continue
        report = update_locked_json(path, lambda data: sync_config(src, data, replace), dry_run)
        results.append((name, describe_sync(report)))
    return results


