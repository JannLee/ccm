def main(argv=None):
    if WINDOWS:
        for stream in (sys.stdout, sys.stderr):
            if hasattr(stream, "reconfigure"):
                stream.reconfigure(encoding="utf-8")
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-n", "--no-launch", "--"):
        argv = ["pick"] + argv
    # pick, run, next 뒤의 인자는 claude에 그대로 넘긴다 (예: ccm -- -c, ccm run work -c, ccm next -c)
    claude_args = []
    if argv[0] in ("pick", "run", "next") and "--" in argv:
        i = argv.index("--")
        argv, claude_args = argv[:i], argv[i + 1:]
    if argv[0] == "run" and len(argv) > 2:
        argv, claude_args = argv[:2], argv[2:] + claude_args
    if argv[0] == "next":
        own = [a for a in argv[1:] if a in ("-n", "--no-launch", "-h", "--help")]
        argv, claude_args = ["next"] + own, [a for a in argv[1:] if a not in own] + claude_args
    args = build_parser().parse_args(argv)
    args.claude_args = claude_args
    try:
        if WINDOWS:
            with terminal_mode(None):
                return args.func(args)
        return args.func(args)
    except CcmError as e:
        print(f"ccm: {e}", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"ccm: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print(file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
