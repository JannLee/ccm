def claude_home():
    """CLAUDE_CONFIG_DIR을 쓰지 않을 때의 설정 폴더. 프로필은 여기 있는 설정을 공유한다."""
    return _path_from_env("CCM_CLAUDE_HOME", "~/.claude")


