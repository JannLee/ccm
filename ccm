def cmd_doctor(args):
    cfg = load_config()
    refresh_info(cfg)
    save_config(cfg)
    warn = 0

    def report(ok, text):
        nonlocal warn
        warn += 0 if ok else 1
        print(f"{'✓' if ok else '!'} {text}")

    exe = claude_bin()
    report(bool(shutil.which(exe)), tr("claude 실행 파일", "claude executable") + f": {shutil.which(exe) or tr('찾지 못함', 'not found')}")
    notice = override_notice()
    if notice:
        report(False, notice)
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        report(False, tr("현재 셸에 CLAUDE_CONFIG_DIR이 설정되어 있어 셸 함수가 계정을 바꾸지 않습니다",
                         "CLAUDE_CONFIG_DIR is set in this shell, so the shell function won't switch accounts"))
    link = install_link_problem()
    if link and link[1] and args.fix:
        relink_install()
        if WINDOWS:
            print("  · " + tr("Windows 실행 파일을 갱신했습니다", "updated Windows launchers") + f": {bin_dir()}")
        else:
            print("  · " + tr("ccm 링크를 다시 만들었습니다", "recreated the ccm link") + f": {bin_dir() / 'ccm'} -> {Path(__file__).resolve()}")
        link = install_link_problem()
    cmd_label = tr("ccm 명령", "ccm command")
    if link:
        report(False, f"{cmd_label}: {link[0]}" + (" (`./ccm doctor --fix`)" if link[1] else ""))
    else:
        report(True, f"{cmd_label}: {shutil.which('ccm')}")
    sl = statusline_problem()
    if sl and sl[1] and args.fix:
        print("  · " + tr("상태줄 명령", "status line command") + f": {install_statusline()}")
        sl = statusline_problem()
    report(sl is None, tr("상태줄 연결", "status line connected") if sl is None else sl[0])
    rc = rc_file()
    hooked = rc.exists() and RC_BEGIN in read_rc(rc)
    report(hooked, tr(f"셸 함수 {rc}" + ("" if hooked else " 에 없음 (`ccm setup`)"),
                      f"shell function in {rc}" if hooked else f"shell function not found in {rc} (`ccm setup`)"))
    seen = {}
    for name, p in cfg["profiles"].items():
        label = account_label(cfg, name)
        info = p.get("info") or {}
        report(bool(info.get("loggedIn")) and not info.get("error"), f"[{name}] {label}")
        key = (info.get("email"), info.get("orgName"))
        if info.get("email"):
            if key in seen:
                report(False, tr(f"[{name}] {seen[key]} 프로필과 같은 계정입니다", f"[{name}] same account as {seen[key]}"))
            seen.setdefault(key, name)
        if name == DEFAULT or not profile_dir(name).is_dir():
            continue
        if args.fix:
            done = repair_links(profile_dir(name), p.get("share_history", True), name)
            if done:
                print("  · " + tr("다시 연결했습니다", "relinked") + f": {describe_repairs(done)}")
        for item, problem, fixable in link_problems(cfg, name):
            hint = " (`ccm doctor --fix`)" if fixable else ""
            report(False, f"[{name}] {item}: {problem}{hint}")
    print(tr("문제 없음", "No problems found") if warn == 0 else tr(f"확인할 항목 {warn}개", f"{warn} item{'s' if warn != 1 else ''} to check"))
    return 0 if warn == 0 else 1


