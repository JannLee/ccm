def rc_file():
    if WINDOWS:
        explicit = os.environ.get("CCM_POWERSHELL_PROFILE")
        if explicit:
            return Path(explicit).expanduser()
        try:
            result = subprocess.run(
                [powershell_bin(), "-NoLogo", "-NoProfile", "-NonInteractive", "-Command",
                 "[Console]::OutputEncoding = [Text.UTF8Encoding]::new(); $PROFILE.CurrentUserAllHosts"],
                capture_output=True, encoding="utf-8", timeout=10, check=True)
        except (OSError, subprocess.SubprocessError) as e:
            raise CcmError(tr("PowerShell 프로필을 찾지 못했습니다. CCM_POWERSHELL_PROFILE에 경로를 지정하세요.",
                              "Could not find the PowerShell profile. Set CCM_POWERSHELL_PROFILE to its path.")) from e
        if not result.stdout.strip():
            raise CcmError("PowerShell profile path is empty")
        return Path(result.stdout.strip())
    if os.path.basename(os.environ.get("SHELL", "")) == "bash":
        return Path.home() / (".bash_profile" if sys.platform == "darwin" else ".bashrc")
    return Path.home() / ".zshrc"


