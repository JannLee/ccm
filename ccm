def mac_languages():
    """macOS 시스템 언어 목록(선호 순서). macOS가 아니거나 읽지 못하면 빈 목록."""
    if sys.platform != "darwin":
        return []
    try:
        with open(Path.home() / "Library" / "Preferences" / ".GlobalPreferences.plist", "rb") as f:
            langs = plistlib.load(f).get("AppleLanguages")
    except (OSError, ValueError, plistlib.InvalidFileException):
        return []
    return [str(x) for x in langs] if isinstance(langs, list) else []


def detect_lang():
    """(출력 언어, 근거)를 돌려준다. CCM_LANG → `ccm lang`으로 저장한 값 → 로캘 → macOS 시스템 언어 순서로 본다.

    macOS는 시스템 언어가 한국어여도 터미널의 LANG이 en_US인 경우가 흔하다. 그래서 로캘이 ko가 아니면
    시스템 언어를 한 번 더 보고, 둘 다 한국어가 아니면 영어로 출력한다.
    """
    env = (os.environ.get("CCM_LANG") or "").strip().lower()
    if env in LANGS:
        return env, "CCM_LANG"
    cfg = read_json(ccm_home() / "config.json", {})
    saved = cfg.get("lang") if isinstance(cfg, dict) else None
    if saved in LANGS:
        return saved, "saved"
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if (os.environ.get(var) or "").lower().startswith("ko"):
            return "ko", var
    langs = mac_languages()
    if langs and langs[0].lower().startswith("ko"):
        return "ko", "macOS"
    return "en", "system"


def ui_lang():
    global _LANG
    if _LANG is None:
        _LANG = detect_lang()[0]
    return _LANG


def tr(ko, en):
    """출력 문구를 지금 언어로 고른다. 문구가 쓰이는 자리에 두 언어를 나란히 적는다."""
    return ko if ui_lang() == "ko" else en


