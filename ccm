    cfg["current"] = name
    save_config(cfg)
    ago = f", {fmt_ago(rec['updated_at'], now)} 기록" if rec.get("updated_at") else ""
    print(f"현재 계정을 {name}(으)로 바꿨습니다: {usage_summary(rec, now)}{ago}")
    if args.no_launch:
        return 0
    return launch(name, args.claude_args)


def cmd_add(args):
    name = args.name
    if name == DEFAULT or not NAME_RE.match(name):
        raise CcmError("이름은 영문·숫자·. _ - 로 24자 이내여야 하고 default는 쓸 수 없습니다.")
    cfg = load_config()
    if name in cfg["profiles"]:
        raise CcmError(f"{name} 프로필이 이미 있습니다. 다시 로그인하려면 `ccm login {name}`을 쓰세요.")
    d = profile_dir(name)
    if d.exists():
        raise CcmError(f"폴더가 이미 있습니다: {d}")
    d.mkdir(mode=0o700, parents=True)
    share_history = not args.no_share_history
    linked = repair_links(d, share_history, name)
    cfg["profiles"][name] = {"created_at": time.time(), "share_history": share_history}
    save_config(cfg)
    print(f"프로필 폴더를 만들었습니다: {d}")
    print(f"~/.claude와 공유하는 항목: {describe_repairs(linked) or '없음'}")
    code = login_flow(cfg, name, args.email, args.sso)
    if code == 0 and not args.no_sync and claude_json(DEFAULT).exists():
        # 새 계정에서도 default에 등록한 MCP 서버를 쓰고 이미 신뢰한 폴더를 다시 묻지 않게 한다
        try:
            for _, text in sync_profiles(DEFAULT, [name]):
                print(f"default 계정에서 가져온 설정: {text}")
        except (CcmError, OSError) as e:
            print(f"주의: default 계정의 MCP 서버와 폴더 신뢰 설정을 가져오지 못했습니다({e}). "
                  f"`ccm sync {name}`으로 다시 시도하세요.")
    return code


