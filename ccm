    link.symlink_to(Path(__file__).resolve())


def read_launcher(path):
    try:
        return path.read_text(encoding="utf-8-sig")
    except (OSError, UnicodeError):
        return None


def windows_launchers():
    python, script = str(Path(sys.executable)), str(Path(__file__).resolve())
    cmd_python, cmd_script = python.replace("%", "%%"), script.replace("%", "%%")
    cmd = (
        '@echo off\nsetlocal DisableDelayedExpansion\n'
        'for /f "tokens=2 delims=:" %%C in (\'chcp\') do set "_ccmCodePage=%%C"\n'
        'chcp 65001 >nul\n'
        f'"{cmd_python}" -X utf8 "{cmd_script}" %*\n'
        'set "_ccmExit=%errorlevel%"\n'
        'if defined _ccmCodePage chcp %_ccmCodePage% >nul\n'
        'exit /b %_ccmExit%\n')
    ps = (
        "$ccmOldProfile = $env:CCM_POWERSHELL_PROFILE\n"
        "try {\n"
        "    if (-not $env:CCM_POWERSHELL_PROFILE) { $env:CCM_POWERSHELL_PROFILE = $PROFILE.CurrentUserAllHosts }\n"
        f"    & {ps_quote(python)} -X utf8 {ps_quote(script)} @args\n"
        "    $ccmStatus = $LASTEXITCODE\n"
        "} finally {\n"
        "    $env:CCM_POWERSHELL_PROFILE = $ccmOldProfile\n"
        "}\n"
        "exit $ccmStatus\n")
    return {"ccm.cmd": cmd, "ccm.ps1": ps}


def run_wrapped(cmd, raw):
    """ccm 설치 전에 쓰던 상태줄 명령을 같은 입력으로 실행해 출력을 돌려준다."""
    if cmd is None:
        prev = (read_json(ccm_home() / "statusline-prev.json", {}) or {}).get("statusLine") or {}
        cmd = prev.get("command") if prev.get("type", "command") == "command" else None
    if not cmd or is_ccm_statusline({"command": cmd}):
        return ""
    try:
        if WINDOWS:
            bash = os.environ.get("CLAUDE_CODE_GIT_BASH_PATH")
            git = shutil.which("git")
            if not bash and git:
                candidate = Path(git).resolve().parent.parent / "bin" / "bash.exe"
                if candidate.is_file():
                    bash = str(candidate)
            command = [bash, "-c", cmd] if bash else [powershell_bin(), "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", cmd]
            r = subprocess.run(command, input=raw, capture_output=True, timeout=10)
        else:
            r = subprocess.run(cmd, shell=True, input=raw, capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout.decode("utf-8", "replace").rstrip("\r\n")


