    return os.environ.get("CCM_CLAUDE_BIN") or shutil.which("claude") or "claude"


def bin_dir():
    """install.sh가 ccm 링크를 만드는 폴더."""
    return _path_from_env("CCM_BIN_DIR", "~/.local/bin")


def script_path():
    """설정 파일에 적을 ccm 경로. PATH의 ccm 링크가 이 파일을 가리키면 링크 경로를 쓴다."""
    here = Path(__file__).resolve()
    found = shutil.which("ccm")
    if not WINDOWS and found and Path(found).resolve() == here:
        return Path(found).absolute()
    return here


def profile_dir(name):
    return None if name == DEFAULT else ccm_home() / "profiles" / name


def claude_json(name):
    """계정의 Claude Code 전역 설정 파일. MCP 서버와 폴더 신뢰 여부가 들어 있고, default는 홈 폴더에 있다."""
    d = profile_dir(name)
    return (Path.home() if d is None else d) / ".claude.json"


def profile_env(name):
    env = dict(os.environ)
    d = profile_dir(name)
    if d is None:
        env.pop("CLAUDE_CONFIG_DIR", None)
    else:
        env["CLAUDE_CONFIG_DIR"] = str(d)
    return env


def auth_env(name):
    """계정 확인용 환경. API 키 변수가 있으면 claude auth status가 로그인 계정 대신 그 값을 보고하므로 뺀다."""
    env = profile_env(name)
    for var in OVERRIDE_VARS:
        env.pop(var, None)
    return env


def override_notice():
    """로그인 계정보다 먼저 쓰이는 환경변수가 이 프로세스에 있으면 원인과 조치를 담은 안내문을 돌려준다."""
    found = [v for v in OVERRIDE_VARS if os.environ.get(v)]
    if not found:
        return None
    names = ", ".join(found)
    unset = ("; ".join(f"Remove-Item Env:{v}" for v in found) if WINDOWS
             else f"unset {' '.join(found)}")
    if os.environ.get("CLAUDECODE"):
        return tr(f"{names}: Claude Code 세션 안에서 실행해서 그 세션의 환경변수를 물려받았습니다. "
                  "터미널에서 직접 `ccm`을 실행했을 때 이 안내가 나오지 않으면 문제없습니다.",
                  f"{names}: inherited from the Claude Code session this was run in. "
                  "If running `ccm` directly in a terminal doesn't show this, there is nothing to fix.")
    return tr(f"{names} 환경변수가 이 셸에 남아 있어, 여기서 실행하는 claude는 로그인 계정 대신 그 값을 씁니다. "
              f"설정 파일에서 지웠다면 새 터미널을 열거나 `{unset}`를 실행하세요.",
              f"{names} is set in this shell, so claude started here uses it instead of the logged-in account. "
              f"If you removed it from your shell config, open a new terminal or run `{unset}`.")


