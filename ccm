def cmd_rm(args):
    cfg = load_config()
    name = resolve_name(cfg, args.name)
    if name == DEFAULT:
        raise CcmError("default 프로필은 지울 수 없습니다.")
    d = profile_dir(name)
    if not args.yes:
        note = "" if cfg["profiles"][name].get("share_history", True) else " 이 프로필에만 있는 세션 기록도 지워집니다."
        answer = input(f"{name} 프로필의 로그인 정보와 폴더를 지울까요?{note} [y/N] ")
        if answer.strip().lower() not in ("y", "yes"):
            print("취소했습니다.")
            return 1
    if d.is_dir():
        # 키체인에 남은 이 프로필의 로그인 항목은 Claude Code가 직접 지우게 한다
        try:
            subprocess.run([claude_bin(), "auth", "logout"], env=profile_env(name),
                           stdin=subprocess.DEVNULL, capture_output=True, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            print(f"주의: 로그아웃하지 못했습니다({e}).", file=sys.stderr)
        remove_profile_dir(d)
    cfg["profiles"].pop(name)
    if cfg["current"] == name:
        cfg["current"] = DEFAULT
    save_config(cfg)
    usage_path(name).unlink(missing_ok=True)
    print(f"{name} 프로필을 지웠습니다. 현재 계정: {cfg['current']}")
    return 0


