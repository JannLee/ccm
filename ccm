# ---------- 파일 ----------

def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_text(path, text, mode=0o600):
    """임시 파일에 쓴 뒤 이름을 바꿔 저장한다. 심볼릭 링크면 링크가 가리키는 파일에 쓴다."""
    path = Path(path)
    if path.is_symlink():
        path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        mode = path.stat().st_mode & 0o777
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_json(path, data, mode=0o600):
    write_text(path, json.dumps(data, ensure_ascii=False, indent=2) + "\n", mode)


# ---------- 설정 ----------

def load_config():
    path = ccm_home() / "config.json"
    cfg = read_json(path)
    if cfg is None and not path.exists():
        cfg = {}
    if not isinstance(cfg, dict) or not isinstance(cfg.get("profiles") or {}, dict):
        # 읽지 못한 채로 저장하면 계정 목록이 지워지므로 여기서 멈춘다
        raise CcmError(f"{path}를 읽지 못했습니다. JSON 문법을 고치거나 파일을 다른 곳으로 옮긴 뒤 다시 실행하세요.")
    profiles = cfg.get("profiles") or {}
    # default 프로필은 늘 첫 번째에 둔다
    cfg["profiles"] = {DEFAULT: profiles.pop(DEFAULT, {}), **profiles}
    if cfg.get("current") not in cfg["profiles"]:
        cfg["current"] = DEFAULT
    return cfg


def save_config(cfg):
    home = ccm_home()
    home.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_json(home / "config.json", cfg)
    # 셸 함수가 파이썬을 띄우지 않고 읽도록 현재 프로필 폴더를 평문 파일로 따로 둔다
    d = profile_dir(cfg["current"])
    write_text(home / "current-dir", f"{d}\n" if d else "", 0o644)


def resolve_name(cfg, query):
    names = list(cfg["profiles"])
    q = query.strip()
    if q.isdigit():
        i = int(q)
        if 1 <= i <= len(names):
            return names[i - 1]
        raise CcmError(f"{i}번 계정이 없습니다. 1~{len(names)} 사이 번호를 입력하세요.")
    if q in cfg["profiles"]:
        return q
    ql = q.lower()
    hits = [n for n in names if n.lower().startswith(ql)]
    if not hits:
        hits = [n for n in names
                if ql in ((cfg["profiles"][n].get("info") or {}).get("email") or "").lower()]
    if len(hits) == 1:
        return hits[0]
    if hits:
        raise CcmError(f"'{query}'에 해당하는 계정이 여러 개입니다: {', '.join(hits)}")
    raise CcmError(f"'{query}' 계정을 찾지 못했습니다. `ccm ls`로 목록을 확인하세요.")


def detect_profile(cfg, env=None):
    """CLAUDE_CONFIG_DIR 값으로 지금 실행 중인 프로필을 찾는다. 관리하지 않는 폴더면 None."""
    raw = (os.environ if env is None else env).get("CLAUDE_CONFIG_DIR")
    if not raw:
        return DEFAULT
    real = Path(raw).expanduser().resolve()
    if real == claude_home().resolve():
        return DEFAULT
    for name in cfg["profiles"]:
        d = profile_dir(name)
        if d is not None and d.resolve() == real:
            return name
    return None


# ---------- 로그인 정보 (claude auth status) ----------

def auth_status(name, timeout=30):
    d = profile_dir(name)
    if d is not None and not d.is_dir():
        return {"error": "프로필 폴더 없음"}
    try:
        r = subprocess.run([claude_bin(), "auth", "status", "--json"], env=auth_env(name),
                           stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"error": str(e)}
    try:
        data = json.loads(r.stdout)
    except ValueError:
        lines = (r.stderr or r.stdout).strip().splitlines()
        return {"error": lines[-1][:200] if lines else f"exit {r.returncode}"}
    keys = ("loggedIn", "authMethod", "email", "orgName", "subscriptionType")
    return {k: data[k] for k in keys if k in data}


def refresh_info(cfg, names=None):
    names = list(cfg["profiles"]) if names is None else names
    if not names:
        return
    with ThreadPoolExecutor(max_workers=len(names)) as ex:
        results = list(ex.map(auth_status, names))
    now = time.time()
    for name, info in zip(names, results):
        old = cfg["profiles"][name].get("info") or {}
        if info.get("error") and old.get("email"):
            # 확인에 실패하면 마지막으로 확인한 계정 정보를 남겨 둔다
            info = {**old, "error": info["error"]}
        info["checked_at"] = now
        cfg["profiles"][name]["info"] = info


def account_label(cfg, name):
    d = profile_dir(name)
    if d is not None and not d.is_dir():
        return "폴더 없음"
    info = cfg["profiles"][name].get("info")
    if not info:
        return "확인 전"
    if info.get("error") and not info.get("email"):
        return "확인 실패"
    method = info.get("authMethod")
    if not info.get("loggedIn"):
        return "로그인 필요"
    if method and method != "claude.ai":
        return AUTH_LABELS.get(method, method)
    return info.get("email") or "-"


# ---------- 사용량 기록 ----------

def extract_windows(payload):
    """상태줄 입력의 rate_limits에서 used_percentage가 있는 창(five_hour, seven_day 등)을 꺼낸다."""
    limits = payload.get("rate_limits") if isinstance(payload, dict) else None
    windows = {}
    if isinstance(limits, dict):
        for key, w in limits.items():
            if isinstance(w, dict) and isinstance(w.get("used_percentage"), (int, float)):
                reset = w.get("resets_at")
                windows[key] = {
                    "used_percentage": float(w["used_percentage"]),
                    "resets_at": float(reset) if isinstance(reset, (int, float)) else None,
                }
    return windows


def is_newer_window(old, new):
    """new가 old보다 나중에 받은 값인지 판단한다. 초기화 시각을 모르면 나중 값으로 본다."""
    if not old or old.get("resets_at") is None or new.get("resets_at") is None:
        return True
    gap = new["resets_at"] - old["resets_at"]
    if gap > SAME_WINDOW:
        return True
    if gap < -SAME_WINDOW:
        return False
    # 같은 창 안에서는 사용률이 줄지 않으므로 더 낮은 값은 예전에 받은 값이다
    return new["used_percentage"] >= old["used_percentage"]


def record_usage(name, payload, now=None):
    """상태줄 입력의 사용률을 계정 기록에 합치고, 합친 기록을 돌려준다.

    같은 계정으로 세션을 여러 개 띄우면 쉬고 있던 세션도 프롬프트 캐시가 만료되거나 창이 초기화될 때
    자기가 마지막으로 받은 값으로 상태줄을 다시 그린다. 이런 예전 값으로는 기록을 바꾸지 않는다.
    """
    now = time.time() if now is None else now
    path = usage_path(name)
    rec = read_json(path, {}) or {}
    windows = extract_windows(payload)
    if not windows:
        return rec
    saved = dict(rec.get("windows") or {})
    fresh = {k: w for k, w in windows.items() if is_newer_window(saved.get(k), w)}
    changed = any(saved.get(k) != w for k, w in fresh.items())
    # 상태줄은 자주 호출되므로 값이 그대로면 30초에 한 번만 파일에 쓴다. 예전 값이 섞인 호출은 기록 시각도 바꾸지 않는다
    if not changed and (len(fresh) < len(windows) or now - rec.get("updated_at", 0) < 30):
        return rec
    saved.update(fresh)
    rec = {"windows": saved, "updated_at": now}
    write_json(path, rec)
    return rec


def window_state(rec, key, now):
    """(사용률, 초기화 시각, 초기화 시각이 지났는지)를 돌려준다. 기록이 없으면 None."""
    w = ((rec or {}).get("windows") or {}).get(key)
    if not w:
        return None
    reset = w.get("resets_at")
    if reset and reset <= now:
        return 0.0, None, True
    return w["used_percentage"], reset, False


def window_pcts(rec, now):
    """(5시간, 주간) 창의 지금 사용률. 기록이 없는 창은 None."""
    states = [window_state(rec, key, now) for key in ("five_hour", "seven_day")]
    return tuple(None if s is None else s[0] for s in states)


def usage_summary(rec, now):
    five, seven = window_pcts(rec, now)
    parts = [f"{label} {pct:.0f}%" for label, pct in (("5시간", five), ("주간", seven)) if pct is not None]
    return " · ".join(parts) or "기록 없음"


def available_at(rec, now):
    """한도에 도달한 창이 모두 초기화되는 시각. 한도에 걸린 창이 없으면 now, 초기화 시각을 모르면 None."""
    times = []
    for key in ("five_hour", "seven_day"):
        state = window_state(rec, key, now)
        if state and state[0] >= 100:
            if not state[1]:
                return None
            times.append(state[1])
    return max(times, default=now)


def account_key(cfg, name):
    """로그인한 계정을 가리키는 (이메일, 조직). 확인 전이면 None."""
    info = cfg["profiles"][name].get("info") or {}
    return (info["email"], info.get("orgName")) if info.get("email") else None


def usage_record(cfg, name):
    """name의 사용량 기록. 같은 계정으로 로그인한 프로필은 한도를 함께 쓰므로 그중 가장 최근 기록을 쓴다."""
    key = account_key(cfg, name)
    names = [n for n in cfg["profiles"] if key and account_key(cfg, n) == key] or [name]
    recs = [read_json(usage_path(n), {}) or {} for n in names]
    return max(recs, key=lambda r: r.get("updated_at") or 0)


def can_switch(cfg, name):
    """claude.ai 계정으로 로그인되어 있어 바로 쓸 수 있는 프로필인지."""
    d = profile_dir(name)
    info = cfg["profiles"][name].get("info") or {}
    return ((d is None or d.is_dir()) and bool(info.get("loggedIn"))
            and info.get("authMethod") in (None, "claude.ai"))


def rank_accounts(cfg, now, exclude=None):
    """바꿀 수 있는 계정을 여유가 많은 순서로 (이름, 사용량 기록, 한도 도달 여부) 목록으로 돌려준다.

    두 창 가운데 한도에 더 가까운 쪽의 사용률이 낮은 계정이 앞에 온다. 기록이 없는 창은 0%로 본다.
    exclude와 같은 계정으로 로그인한 프로필은 한도를 함께 쓰므로 함께 뺀다.
    """
    skip = account_key(cfg, exclude) if exclude else None
    ranked = []
    for i, name in enumerate(cfg["profiles"]):
        if name == exclude or skip and account_key(cfg, name) == skip or not can_switch(cfg, name):
            continue
        rec = usage_record(cfg, name)
        five, seven = window_pcts(rec, now)
        peak = max(five or 0, seven or 0)
        ranked.append(((peak >= 100, peak, five or 0, i), name, rec))
    ranked.sort(key=lambda r: r[0])
    return [(name, rec, key[0]) for key, name, rec in ranked]


# ---------- 출력 ----------

ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")


def dwidth(text):
    width = 0
    for ch in ANSI_RE.sub("", text):
        if unicodedata.combining(ch):
            continue
        width += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return width


def truncate(text, width):
    """색 코드가 없는 문자열을 화면 폭 width 안으로 자른다."""
    if dwidth(text) <= width:
        return text
    out = ""
    for ch in text:
        if dwidth(out + ch) > width - 1:
            break
        out += ch
    return out + "…"


def pad(text, width):
    return text + " " * max(0, width - dwidth(text))


class Paint:
    def __init__(self, enabled):
        self.enabled = enabled

    def __call__(self, text, code):
        return f"\x1b[{code}m{text}\x1b[0m" if self.enabled and code and text else text


def use_color(stream):
    return stream.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb"


def color_for(pct):
    return "31" if pct >= 90 else "33" if pct >= 70 else "32"


def fmt_clock(ts, now):
    t, n = datetime.fromtimestamp(ts), datetime.fromtimestamp(now)
    return t.strftime("%H:%M") if t.date() == n.date() else f"{t.month}/{t.day} {t:%H:%M}"


def fmt_ago(ts, now):
    sec = max(0, now - ts)
    if sec < 60:
        return "방금"
    if sec < 3600:
        return f"{int(sec // 60)}분 전"
    if sec < 86400:
        return f"{int(sec // 3600)}시간 전"
    return f"{int(sec // 86400)}일 전"


def bar(pct, width, paint):
    filled = max(0, min(width, round(pct / 100 * width)))
    return paint("█" * filled, color_for(pct)) + paint("░" * (width - filled), "2")


def window_cell(state, now, paint, bar_width):
    if state is None:
        return paint("기록 없음", "2")
    pct, reset, passed = state
    text = f"{bar(pct, bar_width, paint)} {paint(f'{pct:3.0f}%', color_for(pct))}"
    if passed:
        return f"{text} {paint('초기화됨', '32')}"
    if pct >= 100:
        text += f" {paint('한도', '1;31')}"
    if reset:
        return f"{text} ↻{fmt_clock(reset, now)}"
    return text


def render_table(cfg, now, paint, width, selected=None):
    """표를 줄 목록으로 돌려준다. selected(0부터 센 행 번호)를 주면 그 행에 커서를 표시하고 반전색으로 강조한다."""
    bar_width = 8 if width >= 120 else 5
    header = ["", "#", "이름", "계정", "요금제", "5시간 사용", "주간 사용", "기록"]
    rows = []
    for i, name in enumerate(cfg["profiles"], 1):
        info = cfg["profiles"][name].get("info") or {}
        rec = usage_record(cfg, name)
        current = name == cfg["current"]
        rows.append([
            paint("●", "36") if current else " ",
            str(i),
            name,
            account_label(cfg, name),
            (info.get("subscriptionType") or "-").capitalize(),
            window_cell(window_state(rec, "five_hour", now), now, paint, bar_width),
            window_cell(window_state(rec, "seven_day", now), now, paint, bar_width),
            fmt_ago(rec["updated_at"], now) if rec.get("updated_at") else "-",
        ])
    gap = "  "
    account = 3
    if selected is not None:
        header.insert(0, "")
        for i, r in enumerate(rows):
            r.insert(0, "❯" if i == selected else " ")
        account += 1
    widths = [max(dwidth(r[c]) for r in [header] + rows) for c in range(len(header))]
    room = width - (sum(widths) - widths[account]) - len(gap) * (len(widths) - 1)
    keep = list(range(len(header)))
    if room < 12:
        # 터미널이 좁으면 계정(이메일) 열을 뺀다
        keep.remove(account)
    elif widths[account] > room:
        widths[account] = room
        for r in rows:
            r[account] = truncate(r[account], room)
    lines = []
    for n, r in enumerate([header] + rows):
        line = gap.join(pad(r[c], widths[c]) for c in keep).rstrip()
        lines.append(paint(line, "2") if n == 0 else line)
    if selected is not None and paint.enabled:
        # 행 안의 색 코드가 끝날 때마다 반전을 다시 켜서 강조가 행 끝까지 이어지게 한다
        full = max(dwidth(line) for line in lines)
        row = lines[selected + 1]
        lines[selected + 1] = "\x1b[7m" + pad(row, full).replace("\x1b[0m", "\x1b[0;7m") + "\x1b[0m"
    return lines


def frame_lines(cfg, now, paint, width, selected=None, interactive=False):
    title = f"Claude Code 계정 · 현재 {cfg['current']} · {datetime.fromtimestamp(now):%H:%M} 기준"
    lines = [paint(title, "1")] + render_table(cfg, now, paint, width, selected)
    lines.append(paint("사용량은 각 계정으로 Claude Code를 쓸 때 상태줄이 받은 마지막 값이며, "
                       "초기화 시각이 지난 창은 0%로 표시합니다.", "2"))
    ranked = rank_accounts(cfg, now, exclude=cfg["current"])
    if ranked and not ranked[0][2]:
        name, rec, _ = ranked[0]
        n = list(cfg["profiles"]).index(name) + 1
        hint = "" if interactive else " · `ccm next`로 전환"
        lines.append(paint(f"여유가 가장 많은 다른 계정: {n} {name} ({usage_summary(rec, now)}){hint}", "36"))
    problem = statusline_problem()
    if problem:
        lines.append(paint(problem[0], "33"))
    notice = override_notice()
    if notice:
        lines.append(paint(notice, "33"))
    return lines


def print_table(cfg):
    paint = Paint(use_color(sys.stdout))
    width = shutil.get_terminal_size((100, 24)).columns
    print("\n".join(frame_lines(cfg, time.time(), paint, width)))


# ---------- 방향키 선택 화면 ----------

def read_key(fd):
    """키 하나를 읽어 'up', 'down', 'enter', 'esc' 또는 입력한 문자로 돌려준다."""
    ch = os.read(fd, 1)
    if not ch:
        raise EOFError
    if ch == b"\x03":
        # 보통은 터미널이 Ctrl+C를 신호로 보내지만, 바이트로 들어와도 같은 동작을 하게 한다
        raise KeyboardInterrupt
    if ch == b"\x1b":
        # 방향키도 ESC로 시작하는 바이트열로 들어오므로, 뒤따르는 바이트가 없을 때만 ESC 키로 본다
        seq = b""
        while select.select([fd], [], [], 0.1)[0]:
            seq += os.read(fd, 1)
            if len(seq) >= 2 and (seq[-1:].isalpha() or seq[-1:] == b"~"):
                break
        if not seq:
            return "esc"
        return {b"[A": "up", b"OA": "up", b"[B": "down", b"OB": "down"}.get(seq, "")
    if ch in (b"\r", b"\n"):
        return "enter"
    return ch.decode("utf-8", "ignore")


def pick_interactive(cfg, no_launch):
    """방향키로 계정을 고르게 한다. 고른 이름을 돌려주고(cfg의 현재 계정도 바꾼다), 종료하면 None을 돌려준다."""
    names = list(cfg["profiles"])
    selected = names.index(cfg["current"])
    out, fd = sys.stdout, sys.stdin.fileno()
    paint = Paint(use_color(out))
    help_line = paint(f"↑↓ 이동 · Enter {'전환' if no_launch else '실행'} · ESC 종료", "2")
    drawn = 0

    def draw(status, mark=True):
        nonlocal drawn
        width = shutil.get_terminal_size((100, 24)).columns
        lines = frame_lines(cfg, time.time(), paint, width, selected if mark else None, True) + [status]
        # 앞서 그린 화면의 첫 줄로 올라가 그 아래를 지우고 다시 그린다
        if drawn > 1:
            out.write(f"\x1b[{drawn - 1}A")
        out.write("\r\x1b[J" + "\n".join(lines))
        out.flush()
        drawn = sum(max(1, -(-dwidth(line) // width)) for line in lines)

    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        out.write("\x1b[?25l")  # 다시 그리는 동안 커서를 숨긴다
        draw(help_line)
        confirming = False
        while True:
            try:
                key = read_key(fd)
            except EOFError:
                return None
            if confirming:
                if key in ("y", "Y", "enter"):
                    draw(paint("종료했습니다.", "2"), mark=False)
                    return None
                if key in ("n", "N", "esc"):
                    confirming = False
                    draw(help_line)
                continue
            if key in ("up", "k"):
                selected = (selected - 1) % len(names)
            elif key in ("down", "j"):
                selected = (selected + 1) % len(names)
            elif len(key) == 1 and key in "123456789" and int(key) <= len(names):
                selected = int(key) - 1
            elif key == "enter":
                name = names[selected]
                cfg["current"] = name
                done = (f"현재 계정을 {name}(으)로 바꿨습니다." if no_launch
                        else f"→ {name} 계정으로 claude를 실행합니다.")
                draw(paint(done, "36"), mark=False)
                return name
            elif key in ("esc", "q"):
                confirming = True
                draw(paint("ccm을 종료할까요? [Y/n]", "33"))
                continue
            else:
                continue
            draw(help_line)
    finally:
        out.write("\x1b[?25h\n")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


# ---------- 프로필 폴더 ----------

def shared_items(share_history):
    return SHARED_CONFIG + (SHARED_HISTORY if share_history else [])


def merge_dir(src, dst, tag):
    """dst(계정 폴더 안의 실제 폴더)에 있는 항목을 src(~/.claude 쪽 폴더)로 옮기고 옮긴 개수를 돌려준다.

    같은 이름이 이미 있으면 폴더는 안쪽까지 합치고, 파일은 이름 뒤에 계정 이름을 붙여 옮긴다.
    같은 파일 시스템 안에서는 이름만 바뀌므로 실행 중인 세션이 열어 둔 파일도 그대로 이어서 쓰인다.
    """
    moved = 0
    for entry in sorted(dst.iterdir()):
        if entry.name == ".DS_Store":
            entry.unlink()
            continue
        target = src / entry.name
        if target.exists() or target.is_symlink():
            if entry.is_dir() and not entry.is_symlink() and target.is_dir() and not target.is_symlink():
                moved += merge_dir(target, entry, tag)
                entry.rmdir()
                continue
            n = 1
            while target.exists() or target.is_symlink():
                target = src / f"{entry.name}.{tag}{n if n > 1 else ''}"
                n += 1
        shutil.move(str(entry), str(target))
        moved += 1
    return moved


def repair_links(pdir, share_history, tag):
    """프로필 폴더의 공유 링크를 맞춘다. 없는 링크는 만들고, 계정 폴더에 따로 생긴 기록 폴더는
    내용을 ~/.claude로 옮긴 뒤 링크로 바꾼다. (항목, 옮긴 개수, 오류) 목록을 돌려준다."""
    done = []
    for item in shared_items(share_history):
        src, dst = claude_home() / item, pdir / item
        if dst.is_symlink():
            continue
        try:
            if item in STATE_DIRS:
                src.mkdir(parents=True, exist_ok=True)
            if not src.exists():
                continue
            if dst.is_dir() and item in STATE_DIRS:
                moved = merge_dir(src, dst, tag)
                dst.rmdir()
                dst.symlink_to(src)
                done.append((item, moved, None))
            elif not dst.exists():
                dst.symlink_to(src)
                done.append((item, 0, None))
        except OSError as e:
            done.append((item, 0, e))
    return done


def describe_repairs(done):
    parts = []
    for item, moved, error in done:
        if error:
            parts.append(f"{item}(실패: {error})")
        elif moved:
            parts.append(f"{item}(따로 있던 {moved}개 옮김)")
        else:
            parts.append(item)
    return ", ".join(parts)


def ensure_shared(cfg):
    """모든 프로필의 공유 링크를 맞추고, 바꾼 내용이 있으면 계정마다 한 줄씩 알린다."""
    for name, p in cfg["profiles"].items():
        d = profile_dir(name)
        if d is None or not d.is_dir():
            continue
        done = repair_links(d, p.get("share_history", True), name)
        if done:
            print(f"[{name}] ~/.claude와 공유하도록 연결했습니다: {describe_repairs(done)}", file=sys.stderr)


def link_problems(cfg, name):
    """공유 항목 상태를 점검한다. (항목, 문제, 다시 연결할 수 있는지) 목록을 돌려준다."""
    d = profile_dir(name)
    problems = []
    for item in shared_items(cfg["profiles"][name].get("share_history", True)):
        src, dst = claude_home() / item, d / item
        if dst.is_symlink():
            if dst.resolve() != src.resolve():
                problems.append((item, "다른 곳을 가리킴", False))
        elif dst.is_dir() and item in STATE_DIRS:
            problems.append((item, "계정 폴더에 따로 있어 공유되지 않음", True))
        elif dst.exists():
            problems.append((item, "별도 파일로 바뀌어 공유되지 않음", False))
        elif src.exists() or item in STATE_DIRS:
            problems.append((item, "연결 없음", True))
    return problems


def remove_profile_dir(d):
    root = (ccm_home() / "profiles").resolve()
    if d.is_symlink() or d.resolve().parent != root:
        raise CcmError(f"프로필 폴더 위치가 예상과 다릅니다: {d}")
    # 공유 항목은 링크만 지우고 링크가 가리키는 ~/.claude 쪽 원본은 그대로 둔다
    for entry in d.iterdir():
        if entry.is_symlink():
            entry.unlink()
    shutil.rmtree(d)


def launch(name, claude_args, announce=True):
    d = profile_dir(name)
    if d is not None and not d.is_dir():
        raise CcmError(f"{name} 프로필 폴더가 없습니다: {d}")
    exe = claude_bin()
    if announce:
        print(f"→ {name} 계정으로 claude를 실행합니다.", file=sys.stderr)
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execvpe(exe, [exe, *claude_args], profile_env(name))
    except OSError as e:
        raise CcmError(f"claude를 실행하지 못했습니다: {e}")


def login_flow(cfg, name, email=None, sso=False):
    cmd = [claude_bin(), "auth", "login"]
    if email:
        cmd += ["--email", email]
    if sso:
        cmd.append("--sso")
    print("브라우저가 열리면 이 프로필에 쓸 계정으로 로그인하세요.\n"
          "브라우저에 다른 계정이 로그인되어 있으면 로그아웃하거나, 터미널에 나온 주소를 시크릿 창에서 여세요.")
    try:
        subprocess.call(cmd, env=profile_env(name))
    except OSError as e:
        raise CcmError(f"claude를 실행하지 못했습니다: {e}")
    refresh_info(cfg, [name])
    save_config(cfg)
    info = cfg["profiles"][name]["info"]
    if not info.get("loggedIn"):
        print(f"로그인이 확인되지 않았습니다. `ccm login {name}`으로 다시 시도하세요.")
        return 1
    if info.get("authMethod") not in (None, "claude.ai"):
        print(f"주의: 이 프로필은 {account_label(cfg, name)}입니다. "
              f"{', '.join(OVERRIDE_VARS)} 환경변수를 확인하세요.")
    plan = info.get("subscriptionType")
    print(f"로그인 완료: {name} → {info.get('email') or '-'}" + (f" ({plan})" if plan else ""))
    same = [n for n, p in cfg["profiles"].items() if n != name and info.get("email")
            and (p.get("info") or {}).get("email") == info.get("email")
            and (p.get("info") or {}).get("orgName") == info.get("orgName")]
    if same:
        print(f"주의: {', '.join(same)} 프로필과 같은 계정입니다.")
    return 0


# ---------- 상태줄 ----------

def is_ccm_statusline(sl):
    cmd = ((sl or {}).get("command") or "").rstrip()
    return cmd.endswith(" statusline") and "ccm" in cmd


def statusline_command():
    return f"{shlex.quote(sys.executable)} {shlex.quote(str(script_path()))} statusline"


def statusline_problem():
    """상태줄 설정을 점검한다. 문제가 없으면 None, 있으면 (안내문, `doctor --fix`로 고칠 수 있는지)를 돌려준다.

    명령에 적힌 Python이나 ccm 파일이 없으면 Claude Code는 오류를 보여 주지 않고 상태줄을 비워 둔다.
    그래서 ccm 폴더를 옮기면 사용량 기록이 소리 없이 멈추므로 파일이 실제로 있는지까지 확인한다.
    """
    sl = (read_json(settings_path(), {}) or {}).get("statusLine")
    if not is_ccm_statusline(sl):
        return "상태줄이 연결되어 있지 않아 사용량이 기록되지 않습니다. `ccm setup`을 실행하세요.", False
    try:
        words = shlex.split(sl["command"])
    except ValueError:
        return None
    if len(words) >= 3 and not shutil.which(words[-3]):
        return (f"상태줄 명령에 적힌 Python({words[-3]})이 없어 사용량이 기록되지 않습니다. "
                "`ccm doctor --fix`로 고치세요.", True)
    script = words[-2] if len(words) >= 2 else ""
    if "/" in script and not Path(script).expanduser().exists() or "/" not in script and not shutil.which(script):
        return (f"상태줄 명령에 적힌 {script} 파일이 없어 사용량이 기록되지 않습니다. "
                "ccm 폴더를 옮겼다면 새 위치에서 `./ccm doctor --fix`를 실행하세요.", True)
    return None


def install_link_problem():
    """PATH의 ccm 명령을 점검한다. 문제가 없으면 None, 있으면 (안내문, `doctor --fix`로 고칠 수 있는지)를 돌려준다."""
    link, here = bin_dir() / "ccm", Path(__file__).resolve()
    if link.is_symlink() and not link.exists():
        return f"{link} 링크가 가리키는 {os.readlink(link)} 파일이 없습니다", True
    found = shutil.which("ccm")
    if not found:
        return "PATH에서 ccm 명령을 찾지 못했습니다 (`./install.sh`)", False
    if Path(found).resolve() != here:
        return f"PATH의 ccm({found})이 지금 실행한 {here}와 다른 파일입니다", False
    return None


def relink_install():
    """install.sh처럼 ccm 링크가 이 파일을 가리키게 다시 만든다."""
    link = bin_dir() / "ccm"
    if link.is_symlink():
        link.unlink()
    link.symlink_to(Path(__file__).resolve())


def run_wrapped(cmd, raw):
    """ccm 설치 전에 쓰던 상태줄 명령을 같은 입력으로 실행해 출력을 돌려준다."""
    if cmd is None:
        prev = (read_json(ccm_home() / "statusline-prev.json", {}) or {}).get("statusLine") or {}
        cmd = prev.get("command") if prev.get("type", "command") == "command" else None
    if not cmd or is_ccm_statusline({"command": cmd}):
        return ""
    try:
        r = subprocess.run(cmd, shell=True, input=raw, capture_output=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return r.stdout.decode("utf-8", "replace").rstrip("\n")


def status_segment(label, rec, paint, now):
    parts = []
    for key, short in (("five_hour", "5h"), ("seven_day", "7d")):
        state = window_state(rec, key, now)
        if state is None:
            continue
        pct, reset, _ = state
        text = f"{short} {paint(f'{pct:.0f}%', color_for(pct))}"
        if reset:
            text += f" ↻{fmt_clock(reset, now)}"
        parts.append(text)
    head = paint(f"[{label}]", "36")
    return f"{head} {' · '.join(parts)}" if parts else head


